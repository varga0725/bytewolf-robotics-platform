[Unit]
Description=ByteWolf front RGB camera relay (Gazebo to Control Room)
PartOf=bytewolf.target
After=bytewolf-sitl.service
Wants=bytewolf-sitl.service

[Service]
Type=simple
User=bytewolf
Group=bytewolf
WorkingDirectory=/home/bytewolf/bytewolf-robotics/platform

# Gazebo Harmonic's Python bindings and generated protobuf messages are paired
# with Ubuntu 22.04's system Python 3.10 packages.  -s excludes user-site
# packages so a newer protobuf installed for MAVSDK cannot shadow that pair.
Environment=GZ_IP=127.0.0.1
Environment=PX4_GZ_WORLD=forest
Environment=PYTHONPATH=/home/bytewolf/bytewolf-robotics/platform
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3.10 -s -m simulation.perception.camera_stream --sensor front --full-sensors --no-detections

# Topic publication starts after the simulator process, not at the same instant.
# A bounded failure followed by restart is the service's readiness loop.
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=bytewolf.target
