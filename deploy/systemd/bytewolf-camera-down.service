[Unit]
Description=ByteWolf down RGB camera relay (Gazebo to Control Room)
PartOf=bytewolf.target
After=bytewolf-sitl.service
Wants=bytewolf-sitl.service

[Service]
Type=simple
User=bytewolf
Group=bytewolf
WorkingDirectory=/home/bytewolf/bytewolf-robotics/platform
Environment=GZ_IP=127.0.0.1
Environment=PYTHONPATH=/home/bytewolf/bytewolf-robotics/platform
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3.10 -s -m simulation.perception.camera_stream --sensor down --full-sensors

Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=bytewolf.target
