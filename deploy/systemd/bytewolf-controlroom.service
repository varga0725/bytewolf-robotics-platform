[Unit]
Description=ByteWolf Control Room API and static frontends
PartOf=bytewolf.target
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bytewolf
Group=bytewolf
WorkingDirectory=/home/bytewolf/bytewolf-robotics/platform
ExecStart=/home/bytewolf/bytewolf-robotics/platform/.venv/bin/python -m apps.api.server

# Deliberately independent of the simulator. The artefact and replay views are
# useful with no PX4 running, and a dashboard that refuses to load because the
# simulator is down tells an operator less than one that loads and says so.
Restart=always
RestartSec=5

KillSignal=SIGTERM
TimeoutStopSec=20

# The bind address is hard-coded to 127.0.0.1 in apps/api/server.py and must stay
# that way. This API is not purely read-only: it carries mission endpoints that
# reach PX4 through MissionSpec validation, the SafetyGate and an explicit
# operator approval. Remote access belongs to `tailscale serve`, which proxies
# from the tailnet to this loopback socket without widening the bind.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=bytewolf.target
